const tomp3=mk('tomp3','ᴛᴏᴍᴘ3',async({sock,from,sender,msg})=>{const q=msg?.quoted;if(!q||!q.mtype.includes('video'))return sock.sendMessage(from,{text:`❌ Reply to video with .tomp3`,mentions:[sender]});try{const buf=await sock.downloadMediaMessage(q);const inp=`/tmp/in-${Date.now()}.mp4`,out=`/tmp/out-${Date.now()}.mp3`;fs.writeFileSync(inp,buf);await new Promise((res,rej)=>exec(`ffmpeg -y -i "${inp}" "${out}"`,e=>e?rej(e):res()));await sock.sendMessage(from,{audio:fs.readFileSync(out),mimetype:'audio/mpeg',mentions:[sender]});fs.unlinkSync(inp);fs.unlinkSync(out);}catch(e){await sock.sendMessage(from,{text:`❌ ffmpeg needed: ${e.message}`,mentions:[sender]});}});
const black=mk('black','ʙʟᴀᴄᴋ',async({sock,from,sender,msg})=>{const q=msg?.quoted;if(!q)return sock.sendMessage(from,{text:`❌ Reply to image with .black`,mentions:[sender]});const buf=await sock.downloadMediaMessage(q);const inp=`/tmp/b-${Date.now()}.jpg`,out=`/tmp/bo-${Date.now()}.jpg`;fs.writeFileSync(inp,buf);await new Promise((res,rej)=>exec(`ffmpeg -y -i "${inp}" -vf hue=s=0 "${out}"`,e=>e?rej(e):res()));await sock.sendMessage(from,{image:fs.readFileSync(out),mentions:[sender]});fs.unlinkSync(inp);fs.unlinkSync(out);});
