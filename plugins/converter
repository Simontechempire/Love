function audioEffect(name,alias,filter){return mk(name,alias,async({sock,from,sender,msg})=>{const q=msg?.quoted;if(!q||!q.mtype.includes('audio'))return sock.sendMessage(from,{text:`❌ Reply to audio/vn with .${name}`,mentions:[sender]});try{const buf=await sock.downloadMediaMessage(q);const inp=`/tmp/a-${Date.now()}.ogg`,out=`/tmp/ao-${Date.now()}.mp3`;fs.writeFileSync(inp,buf);await new Promise((res,rej)=>exec(`ffmpeg -y -i "${inp}" -af "${filter}" "${out}"`,e=>e?rej(e):res()));await sock.sendMessage(from,{audio:fs.readFileSync(out),mimetype:'audio/mpeg',ptt:true,mentions:[sender]});fs.unlinkSync(inp);fs.unlinkSync(out);}catch(e){await sock.sendMessage(from,{text:`❌ ffmpeg needed: ${e.message}`,mentions:[sender]});}});}
