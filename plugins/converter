const take=mk('take','ᴛᴀᴋᴇ',async({sock,from,sender,msg,text})=>{const q=msg?.quoted;if(!q||!q.mtype.includes('sticker'))return sock.sendMessage(from,{text:`❌ Reply to sticker with .take <pack> | <author>`,mentions:[sender]});const [pack='Love',author='Love']=(text||'').split('|').map(s=>s.trim());const buf=await sock.downloadMediaMessage(q);await sock.sendMessage(from,{sticker:buf,packname:pack,author,mentions:[sender]});});
const exif=mk('exif','ᴇxɪꜰ',async({sock,from,sender,msg})=>{const q=msg?.quoted;if(!q)return sock.sendMessage(from,{text:`❌ Reply to image with .exif`,mentions:[sender]});try{const buf=await sock.downloadMediaMessage(q);const inp=`/tmp/e-${Date.now()}.jpg`;fs.writeFileSync(inp,buf);const out=await new Promise(res=>exec(`exiftool "${inp}"`,(e,so)=>res(so||'No EXIF')));await sock.sendMessage(from,{text:`🔍 *EXIF*\n\n${String(out).slice(0,2000)}`,mentions:[sender]});fs.unlinkSync(inp);}catch(e){await sock.sendMessage(from,{text:`❌ ${e.message}`,mentions:[sender]});}});
const aitts=mk('aitts','ᴀɪᴛᴛꜱ',async({sock,from,sender,text})=>{if(!text)return sock.sendMessage(from,{text:`❌ .aitts <text>`,mentions:[sender]});try{const r=await axios.get(`https://api.vreden.my.id/api/tts?text=${encodeURIComponent(text)}`,{responseType:'arraybuffer',timeout:30000});await sock.sendMessage(from,{audio:Buffer.from(r.data),mimetype:'audio/mpeg',ptt:true,mentions:[sender]});}catch(e){await sock.sendMessage(from,{text:`❌ ${e.message}`,mentions:[sender]});}});
