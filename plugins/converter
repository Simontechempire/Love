const axios=require('axios');
const fs=require('fs');const path=require('path');const {exec}=require('child_process');
const mk=(n,a,f)=>({name:n,alias:[a],category:'CONVERTER',run:f});
async function dl(sock,msg){try{return await sock.downloadMediaMessage(msg?.quoted||msg);}catch{return null;}}
const sticker=mk('sticker','ꜱᴛɪᴄᴋᴇʀ',async({sock,from,sender,msg})=>{const q=msg?.quoted;if(!q)return sock.sendMessage(from,{text:`❌ Reply to image/video with .sticker`,mentions:[sender]});try{const buf=await sock.downloadMediaMessage(q);if(q.mtype.includes('video'))await sock.sendMessage(from,{sticker:buf,mimetype:'video/mp4',mentions:[sender]});else await sock.sendMessage(from,{sticker:buf,mentions:[sender]});}catch(e){await sock.sendMessage(from,{text:`❌ ${e.message}`,mentions:[sender]});}});
